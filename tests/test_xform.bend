# tests/test_xform.bend — `--transform` engine vs sed (same BRE subset and flags g/i;
# expected values were produced with GNU sed over these expression/name pairs).
import Base
import ../src/xform.bend as X
import ../src/bytes.bend as B
import ./lib.bend as T

def bs(s: String) -> List<&2, U32>:
  match s:
    case SNil{}:
      Nil{}
    case SCon{h, t}:
      Char.to_u32(h) <> bs(t)

def run1(r: X.Pe, +name: String, +want: String, +expr: String) -> IO(Unit):
  match r:
    case X.PeErr{msg}:
      T.check(False{}, expr ++ ": " ++ msg)
    case X.PeOk{xc}:
      T.check(B.eq_list(X.apply(xc <> Nil{}, bs(name)), bs(want), True{}),
        "'" ++ expr ++ "' on '" ++ name ++ "' should give '" ++ want ++ "'")

def ck(+expr: String, +name: String, +want: String) -> IO(Unit):
  run1(X.parse(bs(expr)), name, want, expr)

def main() -> IO(Unit):
  do IO<Unit>:
    +c0 : Unit <- ck("s/a/X/", "a", "X")
    +c1 : Unit <- ck("s/a/X/", "abc", "Xbc")
    +c2 : Unit <- ck("s/a/X/", "dir/file.txt", "dir/file.txt")
    +c3 : Unit <- ck("s/a/X/", "aaa", "Xaa")
